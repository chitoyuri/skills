# 使用 `git submodule add <repository-url> sources/<project-name>` 添加 Skill 来源。
[submodule "sources/drawio-skill"]
	path = sources/drawio-skill
	url = https://github.com/Agents365-ai/drawio-skill.git
[submodule "sources/ip-as-logo-skill"]
	path = sources/ip-as-logo-skill
	url = https://github.com/s1dashu/ip-as-logo-skill.git
[submodule "sources/ian-xiaohei-illustrations"]
	path = sources/ian-xiaohei-illustrations
	url = https://github.com/helloianneo/ian-xiaohei-illustrations.git
[submodule "sources/ponytail"]
	path = sources/ponytail
	url = https://github.com/DietrichGebert/ponytail.git
[submodule "sources/punk-skill"]
	path = sources/punk-skill
	url = https://github.com/adrianpunk/Punk-Posters.git
[submodule "sources/antfu-skills"]
	path = sources/antfu-skills
	url = https://github.com/antfu/skills
[submodule "sources/vercel-agent-skills"]
	path = sources/vercel-agent-skills
	url = https://github.com/vercel-labs/agent-skills
[submodule "sources/lieflat-less-ai-tone"]
	path = sources/lieflat-less-ai-tone
	url = https://github.com/larashero3-dotcom/lieflat-less-ai-tone
[submodule "sources/taste-skill"]
	path = sources/taste-skill
	url = https://github.com/Leonxlnx/taste-skill
